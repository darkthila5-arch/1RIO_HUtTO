# Copy to .env (VPS / local). On Railway / Render / Heroku set these in the dashboard instead.

# ---- required ----
# Your number, country code, digits only
OWNER_NUMBER=
# Long random text: openssl rand -hex 32
WEB_SECRET=
ADMIN_USER=admin
# 10+ characters, turns on /admin
ADMIN_PASSWORD=

# ---- pairing ----
# true = only people with the key can link a number
PAIRING_REQUIRE_KEY=false
# 12+ characters, used when PAIRING_REQUIRE_KEY=true
PAIRING_API_KEY=
MAX_SESSIONS=20

# ---- bot ----
BOT_NAME=RIO X MD
PREFIX=.
# public or private
MODE=public
BUTTONS=off
TIMEZONE=Asia/Colombo
# https://your-domain (auto-detected on Render / Railway)
PUBLIC_URL=

# ---- storage ----
# Heroku has no persistent disk: MONGO_URL is REQUIRED there. Elsewhere optional.
MONGO_URL=
MONGO_DB=rio_x_md
# Railway: /data/sessions   Render: /var/data/sessions   Docker compose: set automatically
SESSION_DIR=./sessions

# ---- networking ----
PORT=3000
# 1 = behind one proxy (Render, Railway, Heroku, Caddy, Nginx). 0 = no proxy (plain VPS, port 3000)
TRUST_PROXY=1

# ---- optional ----
MAX_DL_JOBS=3
MAX_DL_MB=50
TIKTOK_RAPIDAPI_KEY=
YTDLP_COOKIES=
